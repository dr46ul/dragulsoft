    "test:e2e": "vitest run --project e2e",
    "prepare": "husky"
  },
  "dependencies": {
    "@iconify-json/solar": "1.2.13",
    "@nuxt/fonts": "1.2.0",
    "@nuxt/icon": "2.6.1",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "nuxt": "^4.6.2",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@nuxt/test-utils": "4.3.4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/user-event": "14.6.8",
    "@testing-library/vue": "8.1.0",
    "@vue/test-utils": "2.5.1",
    "daisyui": "^5.7.50",
    "eslint": "^10.13.0",
    "happy-dom": "21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "playwright-core": "1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vitest": "5.0.5",
    "vue-tsc": "^3.3.13"
  }
