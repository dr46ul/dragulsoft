{
  "name": "dragulsoft",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "vue-tsc --noEmit -p .nuxt/tsconfig.app.json",
