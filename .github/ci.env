# Values shared by every CI job. `.github/actions/setup` loads them into each job's environment.
# Node's version lives in .nvmrc and pnpm's in package.json's packageManager, where local tooling reads them too.

# Vitest and Playwright force colours when CI is set, which leaves escape codes in the logs.
NO_COLOR=1

# Where the e2e job serves the built app for the tests to drive.
E2E_HOST=127.0.0.1
E2E_PORT=3000
